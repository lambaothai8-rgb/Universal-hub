local function GetTankDriver(tankModel)
    if not tankModel then return nil end
    for _, desc in ipairs(tankModel:GetDescendants()) do
        if desc:IsA(loadstring(base64decode("VmVoaWNsZVNlYXQ="))()) or desc:IsA(loadstring(base64decode("U2VhdA=="))()) then
