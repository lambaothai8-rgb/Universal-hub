local function IsMeleeEquipped()
	local FlatIdent_2C2F3 = 0;
	local char;
	local tool;
	local toolName;
	local rangedKeywords;
	while true do
		if (FlatIdent_2C2F3 == 0) then
			char = LocalPlayer.Character;
			if not char then
				return false;
			end
			FlatIdent_2C2F3 = 1;
		end
		if (3 == FlatIdent_2C2F3) then
			for _, kw in ipairs(rangedKeywords) do
				if string.find(toolName, kw) then
					return false;
				end
			end
			if (tool:FindFirstChild("Ammo") or tool:FindFirstChild("GunScript")) then
				return false;
			end
			FlatIdent_2C2F3 = 4;
		end
		if (FlatIdent_2C2F3 == 4) then
			return true;
		end
		if (FlatIdent_2C2F3 == 2) then
			toolName = string.lower(tool.Name);
			rangedKeywords = {"gun","rifle","pistol","shotgun","sniper","smg","blaster","revolver","bow","sung","súng","ammo","ar","ak","m4","glock","bazooka","launcher"};
			FlatIdent_2C2F3 = 3;
		end
		if (FlatIdent_2C2F3 == 1) then
			tool = char:FindFirstChildOfClass("Tool");
			if not tool then
				return false;
			end
			FlatIdent_2C2F3 = 2;
		end
	end
end
local function GetMonstersList()
	local FlatIdent_6CF78 = 0;
	local monsters;
	local ScanObj;
	while true do
		if (FlatIdent_6CF78 == 0) then
			monsters = {};
			ScanObj = nil;
			FlatIdent_6CF78 = 1;
		end
		if (FlatIdent_6CF78 == 1) then
			function ScanObj(obj)
				if (obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj)) then
					local FlatIdent_755A7 = 0;
					local hum;
					local hrp;
					while true do
						if (FlatIdent_755A7 == 0) then
							hum = obj:FindFirstChildOfClass("Humanoid");
							hrp = obj:FindFirstChild("HumanoidRootPart");
							FlatIdent_755A7 = 1;
						end
						if (FlatIdent_755A7 == 1) then
							if (hum and hrp and (hum.Health > 0)) then
								table.insert(monsters, obj);
							end
							break;
						end
					end
				end
			end
			for _, obj in pairs(workspace:GetChildren()) do
				local FlatIdent_580B8 = 0;
				while true do
					if (FlatIdent_580B8 == 0) then
						ScanObj(obj);
						if obj:IsA("Folder") then
							for _, sub in pairs(obj:GetChildren()) do
								ScanObj(sub);
							end
						end
						break;
					end
				end
			end
			FlatIdent_6CF78 = 2;
		end
		if (FlatIdent_6CF78 == 2) then
			return monsters;
		end
	end
end
local function GetClosestMonster()
	local monsters = GetMonstersList();
	local closestMonster = nil;
	local shortestDist = math.huge;
	local char = LocalPlayer.Character;
	local myHRP = char and char:FindFirstChild("HumanoidRootPart");
	if not myHRP then
		return nil;
	end
	for _, monster in pairs(monsters) do
		local mHRP = monster:FindFirstChild("HumanoidRootPart");
		if mHRP then
			local FlatIdent_8DBF2 = 0;
			local dist;
			while true do
				if (FlatIdent_8DBF2 == 0) then
					dist = (mHRP.Position - myHRP.Position).Magnitude;
					if (dist < shortestDist) then
						local FlatIdent_4BEE8 = 0;
						while true do
							if (FlatIdent_4BEE8 == 0) then
								shortestDist = dist;
								closestMonster = monster;
								break;
							end
						end
					end
					break;
				end
			end
		end
	end
	return closestMonster;
end
local function ExecuteTPAttack()
	if IsAttackingTP then
		return;
	end
	if not IsMeleeEquipped() then
		return;
	end
	local char = LocalPlayer.Character;
	local hrp = char and char:FindFirstChild("HumanoidRootPart");
	if not hrp then
		return;
	end
	local targetMonster = GetClosestMonster();
	if not targetMonster then
		return;
	end
	local mHRP = targetMonster:FindFirstChild("HumanoidRootPart");
	if mHRP then
		local FlatIdent_91AA8 = 0;
		local originalCFrame;
		while true do
			if (FlatIdent_91AA8 == 2) then
				if (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) then
					LocalPlayer.Character.HumanoidRootPart.CFrame = originalCFrame;
				end
				IsAttackingTP = false;
				break;
			end
			if (FlatIdent_91AA8 == 0) then
				IsAttackingTP = true;
				originalCFrame = hrp.CFrame;
				FlatIdent_91AA8 = 1;
			end
			if (FlatIdent_91AA8 == 1) then
				hrp.CFrame = mHRP.CFrame * CFrame.new(0, 0, TPAttachDistance);
				task.wait(TPAttackDuration);
				FlatIdent_91AA8 = 2;
			end
		end
	end
end
local function ApplyFullbright()
	if FullbrightEnabled then
		local FlatIdent_23B4 = 0;
		while true do
			if (FlatIdent_23B4 == 0) then
				Lighting.Ambient = Color3.fromRGB(255, 255, 255);
				Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255);
				FlatIdent_23B4 = 1;
			end
			if (FlatIdent_23B4 == 1) then
				Lighting.Brightness = FullbrightLevel;
				Lighting.GlobalShadows = false;
				break;
			end
		end
	end
end
