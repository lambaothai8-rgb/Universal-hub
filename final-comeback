    local onScreen = IsPartOnScreen(mainPart)
    
    local driver = GetTankDriver(tankModel)
    if ESP_TankTeamCheck and driver and driver ~= LocalPlayer then
        if LocalPlayer.Team and driver.Team and LocalPlayer.Team == driver.Team then
            return
