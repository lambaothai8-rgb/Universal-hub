                if player then return player end
            end
        end
    end
    return nil
end

local function IsTankModel(obj)
    if not obj or not obj:IsA(loadstring(base64decode("TW9kZWw="))()) then return false end
    local nameLower = string.lower(obj.Name)
    for _, kw in ipairs(TankKeywords) do
        if string.find(nameLower, kw) then return true end
    end
    local seat = obj:FindFirstChildWhichIsA(loadstring(base64decode("VmVoaWNsZVNlYXQ="))(), true)
    if seat then return true end
    return false
end

