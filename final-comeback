local function ApplyInvisible(state)
    InvisibleEnabled = state
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
    local hum = char:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
    if not hrp or not hum then return end
    local rootJoint = hrp:FindFirstChild(loadstring(base64decode("Um9vdEpvaW50"))()) or (char:FindFirstChild(loadstring(base64decode("TG93ZXJUb3Jzbw=="))()) and char.LowerTorso:FindFirstChild(loadstring(base64decode("Um9vdA=="))()))
    if state then
        if rootJoint and not OriginalRootC0 then OriginalRootC0 = rootJoint.C0 end
        local yOffset = (InvisibleMode == loadstring(base64decode("VW5kZXJncm91bmQ="))()) and -InvisibleOffset or InvisibleOffset
        if not InvisPlatform then
            InvisPlatform = Instance.new(loadstring(base64decode("UGFydA=="))())
            InvisPlatform.Name = loadstring(base64decode("SW52aXNHcm91bmRQbGF0Zm9ybQ=="))()
            InvisPlatform.Size = Vector3.new(20, 1, 20)
            InvisPlatform.Transparency = 1
            InvisPlatform.Anchored = true
            InvisPlatform.CanCollide = true
            InvisPlatform.Parent = workspace
        end
        hrp.CFrame = hrp.CFrame * CFrame.new(0, yOffset, 0)
        InvisPlatform.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3, hrp.Position.Z)
        if rootJoint and OriginalRootC0 then
            if hum.RigType == Enum.HumanoidRigType.R6 then rootJoint.C0 = OriginalRootC0 * CFrame.new(0, 0, -yOffset)
            else rootJoint.C0 = OriginalRootC0 * CFrame.new(0, -yOffset, 0) end
        end
        hum.CameraOffset = Vector3.new(0, -yOffset, 0)
        if InvisLoop then InvisLoop:Disconnect() end
        InvisLoop = RunService.RenderStepped:Connect(function()
            if InvisibleEnabled and hrp and InvisPlatform then
                InvisPlatform.CFrame = CFrame.new(hrp.Position.X, InvisPlatform.Position.Y, hrp.Position.Z)
            end
        end)
    else
        local yOffset = (InvisibleMode == loadstring(base64decode("VW5kZXJncm91bmQ="))()) and -InvisibleOffset or InvisibleOffset
        if InvisLoop then InvisLoop:Disconnect(); InvisLoop = nil end
        hrp.CFrame = hrp.CFrame * CFrame.new(0, -yOffset, 0)
        if rootJoint and OriginalRootC0 then rootJoint.C0 = OriginalRootC0; OriginalRootC0 = nil end
        hum.CameraOffset = Vector3.new(0, 0, 0)
        if InvisPlatform then InvisPlatform:Destroy(); InvisPlatform = nil end
    end
end

