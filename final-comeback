local function IsIgnoredObject(obj)
    if not obj or not obj.Parent then return true end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and obj:IsDescendantOf(p.Character) then return true end
    end
    if obj:IsDescendantOf(workspace.CurrentCamera) or obj:IsDescendantOf(workspace.Terrain) then return true end
    local namesToCheck = {
        string.lower(obj.Name),
        obj.Parent and string.lower(obj.Parent.Name) or loadstring(base64decode(""))(),
        (obj.Parent and obj.Parent.Parent) and string.lower(obj.Parent.Parent.Name) or loadstring(base64decode(""))()
    }
    for _, name in ipairs(namesToCheck) do
        if name ~= loadstring(base64decode(""))() then
            for _, kw in ipairs(IgnoredKeywords) do
                if string.find(name, kw) then return true end
            end
        end
    end
    return false
end

