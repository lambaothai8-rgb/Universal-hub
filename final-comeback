RunService.Heartbeat:Connect(function(delta)
    pcall(function()
        local char = LocalPlayer.Character
        if char and char.Parent then
            local hrp = char:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
            local hum = char:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
            if not hrp or not hrp:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) then return end
            
            UpdateSelfHitboxESP()
            
            if hum and hum.SeatPart then
                local seat = hum.SeatPart
                local vehicleModel = GetVehicleModelFromSeat(seat)
                local targetPart = (vehicleModel and vehicleModel.PrimaryPart) or seat
                
                if seat:IsA(loadstring(base64decode("VmVoaWNsZVNlYXQ="))()) then
                    seat.MaxSpeed = TankManualSpeed
                    seat.Torque = 999999
                end
                
                if FreezeTankEnabled and targetPart then
                    targetPart.Anchored = true
                    targetPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
                
                if targetPart and TankKeysEnabled and not FreezeTankEnabled then
                    DisableCharacterVehicleCollision(vehicleModel)
                    
                    if not VehicleFlyEnabled then
                        local moveVec = Vector3.new(0, 0, 0)
                        local turnStep = 0
                        if tankState.Forward then moveVec = moveVec + targetPart.CFrame.LookVector end
                        if tankState.Backward then moveVec = moveVec - targetPart.CFrame.LookVector end
                        if tankState.Left then turnStep = turnStep + 1 end
                        if tankState.Right then turnStep = turnStep - 1 end
                        
                        if moveVec.Magnitude > 0 then
                            local velocityVec = moveVec.Unit * TankManualSpeed
                            targetPart.AssemblyLinearVelocity = Vector3.new(velocityVec.X, targetPart.AssemblyLinearVelocity.Y, velocityVec.Z)
                        else
                            local localVel = targetPart.CFrame:VectorToObjectSpace(targetPart.AssemblyLinearVelocity)
                            if math.abs(localVel.Z) > 0.2 then
                                targetPart.AssemblyLinearVelocity = Vector3.new(0, targetPart.AssemblyLinearVelocity.Y, 0)
                            end
                        end
                        if turnStep ~= 0 then
                            targetPart.CFrame = targetPart.CFrame * CFrame.Angles(0, math.rad(turnStep * 2.2 * (delta * 60)), 0)
                            targetPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    end
                end
            end
            
            if VehicleFlyEnabled and hum and hum.SeatPart then
                local seat = hum.SeatPart
                local vehicleModel = GetVehicleModelFromSeat(seat)
                local targetPart = (vehicleModel and vehicleModel.PrimaryPart) or seat
                if targetPart then
                    DisableCharacterVehicleCollision(vehicleModel)
                    
                    targetPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    if FreezeCannonEnabled then
                        targetPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                    
                    local flyDir = Vector3.new(0, 0, 0)
                    local camCF = Camera.CFrame
                    local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
                    if flatLook.Magnitude > 0.001 then flatLook = flatLook.Unit else flatLook = Vector3.new(0,0,-1) end
                    
                    local moveVec = Vector3.new(0, 0, 0)
                    if Controls then moveVec = Controls:GetMoveVector() elseif hum then moveVec = hum.MoveDirection end
                    if moveVec.Magnitude > 0 then
                        flyDir = flyDir + (flatLook * -moveVec.Z) + (camCF.RightVector * moveVec.X)
                    end
                    
                    if tankState.Forward then flyDir = flyDir + flatLook end
                    if tankState.Backward then flyDir = flyDir - flatLook end
                    if tankState.Left then flyDir = flyDir - camCF.RightVector end
                    if tankState.Right then flyDir = flyDir + camCF.RightVector end
                    
                    if flyKeys.E or flyKeys.Space or tankState.FlyUp then flyDir = flyDir + Vector3.new(0, 1, 0) end
                    if flyKeys.Q or flyKeys.LeftControl or tankState.FlyDown then flyDir = flyDir - Vector3.new(0, 1, 0) end
                    
                    if flyDir.Magnitude > 0 then
                        local stepSpeed = ClampSafeVelocity(flyDir.Unit * VehicleFlySpeed, 50)
                        targetPart.CFrame = targetPart.CFrame + (stepSpeed / 10 * (delta * 60))
                    end
                end
            end
            
            if (VehicleCamControlEnabled or (TankAimOnClickEnabled and TankAimIsClicking)) and char and hrp then
                local mouse = LocalPlayer:GetMouse()
                local flatLook = nil
                
                if TankAimOnClickEnabled and TankAimIsClicking and mouse and mouse.Hit then
                    local seat = hum and hum.SeatPart
                    local vehicleModel = GetVehicleModelFromSeat(seat)
                    local targetPart = (vehicleModel and vehicleModel.PrimaryPart) or seat or hrp
                    local dir = (mouse.Hit.Position - targetPart.Position)
                    flatLook = Vector3.new(dir.X, 0, dir.Z)
                else
                    local lookVector = Camera.CFrame.LookVector
                    if VehicleInvertDirection then lookVector = -lookVector end
                    flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
                end
                
                if flatLook and flatLook.Magnitude > 0.001 then
                    flatLook = flatLook.Unit
                    if hum and hum.SeatPart then
                        local seat = hum.SeatPart
                        local vehicleModel = GetVehicleModelFromSeat(seat)
                        local targetPart = (vehicleModel and vehicleModel.PrimaryPart) or seat
                        if targetPart and not targetPart.Anchored then
                            DisableCharacterVehicleCollision(vehicleModel)
                            local currentPos = targetPart.Position
                            local targetCF = CFrame.lookAt(currentPos, currentPos + flatLook)
                            targetPart.CFrame = targetPart.CFrame:Lerp(targetCF, 0.25)
                            targetPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            if not VehicleFlyEnabled and targetPart.AssemblyLinearVelocity.Y > 25 then
                                targetPart.AssemblyLinearVelocity = Vector3.new(targetPart.AssemblyLinearVelocity.X, 25, targetPart.AssemblyLinearVelocity.Z)
                            end
                        end
                    else
                        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flatLook)
                    end
                end
            end
            
            if FlyEnabled and not VehicleFlyEnabled then
                local bv = hrp:FindFirstChild(loadstring(base64decode("QW50aUdyYXZpdHlCVg=="))()) or Instance.new(loadstring(base64decode("Qm9keVZlbG9jaXR5"))())
                bv.Name = loadstring(base64decode("QW50aUdyYXZpdHlCVg=="))()
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = hrp
                local moveVec = Vector3.new(0, 0, 0)
                if Controls then moveVec = Controls:GetMoveVector() elseif hum then moveVec = hum.MoveDirection end
                if moveVec.Magnitude > 0 then
                    local camCF = Camera.CFrame
                    local flyDirection = (camCF.LookVector * -moveVec.Z) + (camCF.RightVector * moveVec.X)
                    local safeFlyVector = ClampSafeVelocity(flyDirection.Unit * FlySpeed, 50)
                    hrp.CFrame = hrp.CFrame + (safeFlyVector / 10 * (delta * 60))
                end
            else
                if hrp:FindFirstChild(loadstring(base64decode("QW50aUdyYXZpdHlCVg=="))()) then hrp.AntiGravityBV:Destroy() end
            end
            
            if SpeedEnabled and hum and hum.MoveDirection.Magnitude > 0 then
                local extraSpeed = (SpeedMultiplier - 16) / 10
                local stepMove = ClampSafeVelocity(hum.MoveDirection * extraSpeed, 35)
                hrp.CFrame = hrp.CFrame + (stepMove * (delta * 60))
            end
        end
    end)
    ApplyFullbright()
    ApplyDay()
end)

