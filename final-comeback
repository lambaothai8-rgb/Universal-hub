local function GetMonstersList()
    local monsters = {}
    local function ScanObj(obj)
        if obj:IsA(loadstring(base64decode("TW9kZWw="))()) and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
            local hrp = obj:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
            if hum and hrp and hum.Health > 0 then
                table.insert(monsters, obj)
            end
        end
    end
    for _, obj in pairs(workspace:GetChildren()) do
        ScanObj(obj)
        if obj:IsA(loadstring(base64decode("Rm9sZGVy"))()) then
            for _, sub in pairs(obj:GetChildren()) do ScanObj(sub) end
        end
    end
    return monsters
end

local function GetClosestMonster()
    local monsters = GetMonstersList()
    local closestMonster = nil
    local shortestDist = math.huge
    local char = LocalPlayer.Character
    local myHRP = char and char:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
    if not myHRP then return nil end
    for _, monster in pairs(monsters) do
        local mHRP = monster:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
        if mHRP then
            local dist = (mHRP.Position - myHRP.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closestMonster = monster
            end
        end
    end
    return closestMonster
end

local function ExecuteTPAttack()
    if IsAttackingTP then return end
    if not IsMeleeEquipped() then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
    if not hrp then return end
    local targetMonster = GetClosestMonster()
    if not targetMonster then return end
    local mHRP = targetMonster:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
    if mHRP then
        IsAttackingTP = true
        local originalCFrame = hrp.CFrame
        hrp.CFrame = mHRP.CFrame * CFrame.new(0, 0, TPAttachDistance)
        task.wait(TPAttackDuration)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))()) then
            LocalPlayer.Character.HumanoidRootPart.CFrame = originalCFrame
        end
        IsAttackingTP = false
    end
end

