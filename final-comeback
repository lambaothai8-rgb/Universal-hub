local function ClampSafeVelocity(velVector, maxLimit)
    if typeof(velVector) ~= loadstring(base64decode("VmVjdG9yMw=="))() then return Vector3.new(0, 0, 0) end
    if not LocalMovementLimiterEnabled then return velVector end
    local limit = maxLimit or SAFE_SPEED_LIMIT
