local function StartAutoWeldLoop()
    task.spawn(function()
        while AutoWeldEnabled do
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                
                local tool = char:FindFirstChildOfClass(loadstring(base64decode("VG9vbA=="))())
                if not tool then
                    local backpack = LocalPlayer:FindFirstChildOfClass(loadstring(base64decode("QmFja3BhY2s="))())
                    if backpack then
                        for _, item in ipairs(backpack:GetChildren()) do
                            if item:IsA(loadstring(base64decode("VG9vbA=="))()) then
                                local nameLower = string.lower(item.Name)
                                if string.find(nameLower, loadstring(base64decode("d2VsZA=="))()) or string.find(nameLower, loadstring(base64decode("dG9yY2g="))()) or string.find(nameLower, loadstring(base64decode("cmVwYWly"))()) or string.find(nameLower, loadstring(base64decode("Ymxvdw=="))()) or string.find(nameLower, loadstring(base64decode("aGFu"))()) then
                                    item.Parent = char
                                    tool = item
                                    break
                                end
                            end
                        end
                    end
                end
                
                if tool then
                    tool:Activate()
                end
                local hrp = char:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
                if hrp then
                    for _, prompt in ipairs(workspace:GetDescendants()) do
                        if prompt:IsA(loadstring(base64decode("UHJveGltaXR5UHJvbXB0"))()) and prompt.Enabled then
                            local parentPart = prompt.Parent
                            if parentPart and parentPart:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) then
                                local dist = (hrp.Position - parentPart.Position).Magnitude
                                if dist <= (prompt.MaxActivationDistance or 15) then
                                    prompt.HoldDuration = 0
                                    prompt.RequiresLineOfSight = false
                                    if fireproximityprompt then
                                        fireproximityprompt(prompt)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(PerformanceOptimizerEnabled and 0.2 or 0.05)
        end
    end)
end

