local function GetAimPart(model)
    if not model then return nil end
    if TargetPartType == loadstring(base64decode("SGVhZA=="))() then return model:FindFirstChild(loadstring(base64decode("SGVhZA=="))()) or model:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
    else return model:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))()) or model:FindFirstChild(loadstring(base64decode("VXBwZXJUb3Jzbw=="))()) or model:FindFirstChild(loadstring(base64decode("VG9yc28="))()) or model:FindFirstChild(loadstring(base64decode("SGVhZA=="))()) end
end
local function IsVisible(targetPart, model)
    if not WallCheckEnabled then return true end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {Camera}
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    raycastParams.FilterDescendantsInstances = ignoreList
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local raycastResult = workspace:Raycast(origin, direction, raycastParams)
    if raycastResult then return raycastResult.Instance:IsDescendantOf(model) end
    return true
end
local function GetClosestTargetInFOV()
    local closestModel = nil
    local shortestDistance = FOVRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local function EvaluateModel(model)
        if not model or model == LocalPlayer.Character then return end
        
        local targetPlr = Players:GetPlayerFromCharacter(model)
        if targetPlr and targetPlr ~= LocalPlayer then
            if AimbotTeamCheckEnabled and LocalPlayer.Team and targetPlr.Team and LocalPlayer.Team == targetPlr.Team then
                return
            end
        end
        local targetPart = GetAimPart(model)
        local humanoid = model:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
        if targetPart and humanoid and humanoid.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if onScreen and IsVisible(targetPart, model) then
                local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                if distance < shortestDistance then shortestDistance = distance; closestModel = model end
            end
        end
    end
    if TargetType == loadstring(base64decode("UGxheWVycw=="))() or TargetType == loadstring(base64decode("Qm90aA=="))() then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then EvaluateModel(player.Character) end
        end
    end
    if TargetType == loadstring(base64decode("TW9uc3RlcnM="))() or TargetType == loadstring(base64decode("Qm90aA=="))() then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA(loadstring(base64decode("TW9kZWw="))()) and not Players:GetPlayerFromCharacter(obj) then EvaluateModel(obj)
            elseif obj:IsA(loadstring(base64decode("Rm9sZGVy"))()) then for _, subObj in pairs(obj:GetChildren()) do if subObj:IsA(loadstring(base64decode("TW9kZWw="))()) and not Players:GetPlayerFromCharacter(subObj) then EvaluateModel(subObj) end end end
        end
    end
    return closestModel
end
local function GetTargetPredictedPos(model)
    local targetPart = GetAimPart(model)
    local hrp = model:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))()) or targetPart
    if targetPart and hrp then
        local velocity = hrp.AssemblyLinearVelocity or Vector3.new(0,0,0)
        return targetPart.Position + (velocity * PredictionFactor)
    end
    return nil
end

